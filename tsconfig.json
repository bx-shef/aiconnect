{
  "extends": "./.nuxt/tsconfig.json",
  "vueCompilerOptions": {
    // Незнакомый тег в шаблоне — ошибка типов, а не тихий пустой элемент. Nuxt называет
    // компоненты из подкаталогов с приставкой каталога (components/invoice/FillPreview.vue →
    // InvoiceFillPreview); в шаблоне invoice-from-tasks тег <FillPreview> рисовался пустым, и
    // предпросмотр счёта не показывался вовсе (живой прогон 2026-09-25).
    "checkUnknownComponents": true
  }
}
