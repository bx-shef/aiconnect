# Шаблон окружения. Скопируйте в .env и заполните. Секреты в репозиторий не коммитим.
# Выкат — docs/DEPLOY.md.

# --- Прод: docker-compose.prod.yml за nginx-proxy -----------------------------
# Домен приложения. Из него compose собирает NUXT_PUBLIC_SITE_URL (https://DOMAIN) и адрес для
# nginx-proxy и сертификата; TRUST_PROXY там уже 1. DNS A-запись — на сервер ДО подъёма.
DOMAIN=aiconnect.bx-shef.by
# Контакт для сертификата Let's Encrypt (необязательно).
LETSENCRYPT_EMAIL=

# --- Адрес приложения (docker-compose.yml, pnpm dev) --------------------------
# Абсолютный https-адрес, на котором доступен сервер. Из него строится обработчик событий
# (/api/b24/events). Без него страница установки возьмёт адрес из браузера.
# В docker-compose.prod.yml не нужен — берётся из DOMAIN. ⚠ Не ставьте сюда боевой адрес для
# разработки: установка на тестовом портале привяжет события к нему.
NUXT_PUBLIC_SITE_URL=

# --- Приложение в Битрикс24 ----------------------------------------------------
# Реквизиты из кабинета разработчика Маркета («Протестировать» → client_id и secret_id) или из
# карточки локального приложения. Нужны, чтобы сверить установку (member_id) и обновлять токен
# установщика.
# Без них сервер НЕ сохранит установку (fail-closed, docs/B24_EVENTS.md).
B24_CLIENT_ID=
B24_CLIENT_SECRET=
# Код приложения: в Маркете — из карточки в кабинете (вида код_партнёра.код_приложения); он же
# app.info → CODE, и пока переменная не задана, его показывает администратору главная страница
# приложения. ОБЯЗАТЕЛЕН: без него сервер отвечает 503 на все запросы из фрейма.
B24_APP_CODE=
# application_token. Для приложения из Маркета — пустой: у каждого портала свой, его задаёт
# первый ONAPPINSTALL портала.
B24_APPLICATION_TOKEN=
# Коробочные порталы (не *.bitrix24.*), через запятую: crm.company.by, portal.local — для SSRF-гарда.
# ⚠ Установка из коробки не сохраняется: приложение облачное, коробку сервером авторизации не принимаем.
B24_SELFHOSTED_HOSTS=

# --- Шифрование токенов ---------------------------------------------------------
# 32 байта hex (64 символа) или base64. Сгенерировать: openssl rand -hex 32
# Шифрует оба токена установки (access и refresh). Храните копию ключа вне сервера: потеря или смена
# ключа делает сохранённые токены нечитаемыми — порталам придётся переустановить приложение.
B24_TOKEN_ENC_KEY=

# --- Сеть ------------------------------------------------------------------------
# 1 — сервер стоит за СВОИМ обратным прокси (nginx, Caddy, Traefik), который дописывает адрес клиента
# в X-Forwarded-For. Тогда лимиты частоты считаются по настоящему IP клиента, иначе все запросы
# выглядят пришедшими с адреса прокси и лимиты становятся общими. Заголовку верим только от
# соединений из частной сети (прокси, мост Docker). Рассчитано на один прокси перед сервером.
TRUST_PROXY=
