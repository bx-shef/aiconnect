# Окружение смок-прогона (pnpm smoke, docs/SMOKE.md). Скопируйте в .env.b24test (git-ignored).
# ⚠ Только ТЕСТОВЫЙ портал: смок создаёт сделки, счета, задачи, позиции и дела. Портал должен быть
# в smoke/lib/env.ts → TEST_PORTALS, иначе смок откажется (или B24_SMOKE_YES_TARGET=<домен>).
# Адрес берётся только отсюда — переменная окружения B24_HOOK не читается.
B24_HOOK=https://<тестовый-портал>.bitrix24.by/rest/<id>/<код-вебхука>/

# Необязательно: ключ Вайбкода для проверок BitrixGPT (без него они пропускаются).
VIBE_API_KEY=
